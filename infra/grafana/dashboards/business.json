{
  "uid": "carflow-business",
  "title": "CarFlow - Business throughput",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Bookings created per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{route=\"/booking/bookings\", method=\"POST\"}[1m]))",
          "legendFormat": "bookings/s"
        }
      ]
    },
    {
      "id": 2,
      "title": "Telemetry ingest rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(telemetry_packets_ingested_total[1m]))",
          "legendFormat": "packets/s"
        }
      ]
    }
  ]
}
